#!/usr/bin/env bash

set -e -o pipefail

AWS_ENDPOINT="http://localhost:4566"
AWS_ACCOUNT_ID="000000000000"
AWS_REGION="us-east-1"

APP_NAME="test-app"
EVENTS_TABLE_NAME="${APP_NAME}_events"
SNAPSHOTS_TABLE_NAME="${APP_NAME}_snapshots"
EVENTS_PUBLISHER_LAMBDA_NAME="${APP_NAME}_events-publisher"

TOPIC_NAMES=(
  "${APP_NAME}_test-entity"
  "${APP_NAME}_calculator"
  "${APP_NAME}_snapshotting-calculator"
)

INCOMING_QUEUE_NAMES=(
  "${APP_NAME}_test-entity"
  "${APP_NAME}_calculator"
)

DEAD_LETTER_QUEUE_SUFFIX="_dlq"
MAX_RECEIVE_COUNT=3

source ./events-publisher-lambda/zip

start_floci() {
  echo "Starting floci..."
  docker compose --file ./local/docker-compose-environment.yaml up --detach

  wait_for_floci
}

wait_for_floci() {
  echo "Waiting for floci to be ready..."
  local max_attempts=30 attempt=0

  until aws sns list-topics --endpoint-url "$AWS_ENDPOINT" --region "$AWS_REGION" > /dev/null 2>&1; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge "$max_attempts" ]; then
      echo "  ✗ Error: floci did not become ready after ${max_attempts}s"
      exit 1
    fi
    sleep 1
  done

  echo "  ✓ floci is ready"
}

create_sns_topics() {
  echo "Creating SNS topics..."
  for topic_name in "${TOPIC_NAMES[@]}"; do

    if aws sns get-topic-attributes \
      --topic-arn "arn:aws:sns:${AWS_REGION}:${AWS_ACCOUNT_ID}:${topic_name}" \
      --endpoint-url "$AWS_ENDPOINT" \
      --region "$AWS_REGION" \
      > /dev/null 2>&1; then
      echo "  ℹ Topic already exists: $topic_name"
    else
      aws sns create-topic \
        --name "$topic_name" \
        --endpoint-url "$AWS_ENDPOINT" \
        --region "$AWS_REGION" \
        > /dev/null
      echo "  ✓ Created topic: $topic_name"
    fi
  done
}

create_queue_if_absent() {
  local queue_name="$1"

  if aws sqs get-queue-url \
    --queue-name "$queue_name" \
    --endpoint-url "$AWS_ENDPOINT" \
    --region "$AWS_REGION" \
    > /dev/null 2>&1; then
    echo "  ℹ Queue already exists: $queue_name"
  else
    aws sqs create-queue \
      --queue-name "$queue_name" \
      --endpoint-url "$AWS_ENDPOINT" \
      --region "$AWS_REGION" \
      > /dev/null
    echo "  ✓ Created queue: $queue_name"
  fi
}

set_redrive_policy() {
  local queue_name="$1"
  local dead_letter_queue_name="$2"

  local queue_url
  queue_url=$(aws sqs get-queue-url \
    --queue-name "$queue_name" \
    --endpoint-url "$AWS_ENDPOINT" \
    --region "$AWS_REGION" \
    --query 'QueueUrl' \
    --output text)

  local dead_letter_queue_arn="arn:aws:sqs:${AWS_REGION}:${AWS_ACCOUNT_ID}:${dead_letter_queue_name}"

  local attributes
  attributes=$(printf \
    '{"RedrivePolicy":"{\\"deadLetterTargetArn\\":\\"%s\\",\\"maxReceiveCount\\":\\"%s\\"}"}' \
    "$dead_letter_queue_arn" "$MAX_RECEIVE_COUNT")

  aws sqs set-queue-attributes \
    --queue-url "$queue_url" \
    --attributes "$attributes" \
    --endpoint-url "$AWS_ENDPOINT" \
    --region "$AWS_REGION"

  echo "  ✓ Redriving to $dead_letter_queue_name after $MAX_RECEIVE_COUNT deliveries: $queue_name"
}

create_incoming_sqs_queues_and_subscriptions() {
  echo "Creating incoming SQS queues and SNS subscriptions..."
  for incoming_queue_name in "${INCOMING_QUEUE_NAMES[@]}"; do
    local incoming_topic_name="$incoming_queue_name"
    local dead_letter_queue_name="${incoming_queue_name}${DEAD_LETTER_QUEUE_SUFFIX}"

    local topic_arn="arn:aws:sns:${AWS_REGION}:${AWS_ACCOUNT_ID}:${incoming_topic_name}"
    local queue_arn="arn:aws:sqs:${AWS_REGION}:${AWS_ACCOUNT_ID}:${incoming_queue_name}"

    create_queue_if_absent "$dead_letter_queue_name"
    create_queue_if_absent "$incoming_queue_name"
    set_redrive_policy "$incoming_queue_name" "$dead_letter_queue_name"

    # Subscribe queue to topic with raw message delivery
    if aws sns list-subscriptions-by-topic \
      --topic-arn "$topic_arn" \
      --endpoint-url "$AWS_ENDPOINT" \
      --region "$AWS_REGION" \
      --query "Subscriptions[?Endpoint=='${queue_arn}']" \
      --output text | grep -q "$queue_arn"; then
      echo "  ℹ Subscription already exists: $incoming_topic_name → $incoming_queue_name"
    else
      local subscription_arn
      subscription_arn=$(aws sns subscribe \
        --topic-arn "$topic_arn" \
        --protocol sqs \
        --notification-endpoint "$queue_arn" \
        --endpoint-url "$AWS_ENDPOINT" \
        --region "$AWS_REGION" \
        --query 'SubscriptionArn' \
        --output text)

      aws sns set-subscription-attributes \
        --subscription-arn "$subscription_arn" \
        --attribute-name RawMessageDelivery \
        --attribute-value true \
        --endpoint-url "$AWS_ENDPOINT" \
        --region "$AWS_REGION"

      echo "  ✓ Subscribed queue to topic: $incoming_topic_name → $incoming_queue_name"
    fi
  done
}

create_events_dynamodb_table() {
  local partition_key="entityReference"
  local sort_key="sequenceNumber"

  echo "Creating DynamoDB table: $EVENTS_TABLE_NAME..."
  if aws dynamodb describe-table \
    --table-name "$EVENTS_TABLE_NAME" \
    --endpoint-url "$AWS_ENDPOINT" \
    --region "$AWS_REGION" \
    > /dev/null 2>&1; then
    echo "  ℹ Table already exists: $EVENTS_TABLE_NAME"
  else
    aws dynamodb create-table \
      --table-name "$EVENTS_TABLE_NAME" \
      --key-schema \
        AttributeName="$partition_key",KeyType=HASH \
        AttributeName="$sort_key",KeyType=RANGE \
      --attribute-definitions \
        AttributeName="$partition_key",AttributeType=S \
        AttributeName="$sort_key",AttributeType=N \
      --stream-specification \
        StreamEnabled=true,StreamViewType=NEW_IMAGE \
      --billing-mode PAY_PER_REQUEST \
      --endpoint-url "$AWS_ENDPOINT" \
      --region "$AWS_REGION" \
      > /dev/null
    echo "  ✓ Created table: $EVENTS_TABLE_NAME"
  fi
}

create_snapshots_dynamodb_table() {
  local partition_key="entityReference"

  echo "Creating DynamoDB table: $SNAPSHOTS_TABLE_NAME..."
  if aws dynamodb describe-table \
    --table-name "$SNAPSHOTS_TABLE_NAME" \
    --endpoint-url "$AWS_ENDPOINT" \
    --region "$AWS_REGION" \
    > /dev/null 2>&1; then
    echo "  ℹ Table already exists: $SNAPSHOTS_TABLE_NAME"
  else
    aws dynamodb create-table \
      --table-name "$SNAPSHOTS_TABLE_NAME" \
      --key-schema \
        AttributeName="$partition_key",KeyType=HASH \
      --attribute-definitions \
        AttributeName="$partition_key",AttributeType=S \
      --billing-mode PAY_PER_REQUEST \
      --endpoint-url "$AWS_ENDPOINT" \
      --region "$AWS_REGION" \
      > /dev/null
    echo "  ✓ Created table: $SNAPSHOTS_TABLE_NAME"
  fi
}

create_events_publisher_lambda() {
  local lambda_role="arn:aws:iam::000000000000:role/${EVENTS_PUBLISHER_LAMBDA_NAME}-role"
  local lambda_zip="./events-publisher-lambda/lambda.zip"

  echo "Creating Events publisher lambda: $EVENTS_PUBLISHER_LAMBDA_NAME..."

  if [ ! -f "$lambda_zip" ]; then
    echo "  ✗ Error: Lambda ZIP not found at $lambda_zip"
    echo "  Please run the build script first."
    exit 1
  fi

  local local_lambda_env_vars='{
    "Variables": {
      "APP_NAME": "'"$APP_NAME"'",
      "MAX_CONCURRENT_PUBLISHES": "10",
      "AWS_ENDPOINT_URL": "http://floci:4566"
    }
  }'

  if aws lambda get-function \
    --function-name "$EVENTS_PUBLISHER_LAMBDA_NAME" \
    --endpoint-url "$AWS_ENDPOINT" \
    --region "$AWS_REGION" \
    > /dev/null 2>&1; then
    echo "  ℹ Lambda already exists, updating code and configuration..."

    aws lambda update-function-code \
      --function-name "$EVENTS_PUBLISHER_LAMBDA_NAME" \
      --zip-file "fileb://$lambda_zip" \
      --endpoint-url "$AWS_ENDPOINT" \
      --region "$AWS_REGION" \
      > /dev/null

    aws lambda update-function-configuration \
      --function-name "$EVENTS_PUBLISHER_LAMBDA_NAME" \
      --runtime nodejs24.x \
      --role "$lambda_role" \
      --handler index.handler \
      --environment "$local_lambda_env_vars" \
      --timeout 60 \
      --memory-size 512 \
      --endpoint-url "$AWS_ENDPOINT" \
      --region "$AWS_REGION" \
      > /dev/null

    echo "  ✓ Updated Lambda code and configuration: $EVENTS_PUBLISHER_LAMBDA_NAME"
  else
    aws lambda create-function \
      --function-name "$EVENTS_PUBLISHER_LAMBDA_NAME" \
      --runtime nodejs24.x \
      --role "$lambda_role" \
      --handler index.handler \
      --environment "$local_lambda_env_vars" \
      --timeout 60 \
      --memory-size 512 \
      --endpoint-url "$AWS_ENDPOINT" \
      --region "$AWS_REGION" \
      --zip-file "fileb://$lambda_zip" \
      > /dev/null
    echo "  ✓ Created Lambda: $EVENTS_PUBLISHER_LAMBDA_NAME"
  fi
}

subscribe_events_publisher_lambda_to_dynamodb() {
  echo "Subscribing Events publisher lambda to DynamoDB stream..."

  local stream_arn
  stream_arn=$(aws dynamodb describe-table \
    --table-name "$EVENTS_TABLE_NAME" \
    --endpoint-url "$AWS_ENDPOINT" \
    --region "$AWS_REGION" \
    --query 'Table.LatestStreamArn' \
    --output text)

  if [ -z "$stream_arn" ] || [ "$stream_arn" == "None" ]; then
    echo "  ✗ Error: No stream ARN found for table $EVENTS_TABLE_NAME"
    return 1
  fi

  local existing_mapping
  existing_mapping=$(aws lambda list-event-source-mappings \
    --function-name "$EVENTS_PUBLISHER_LAMBDA_NAME" \
    --endpoint-url "$AWS_ENDPOINT" \
    --region "$AWS_REGION" \
    --query "EventSourceMappings[?EventSourceArn=='$stream_arn'].UUID" \
    --output text)

  if [ -n "$existing_mapping" ]; then
    aws lambda update-event-source-mapping \
      --uuid "$existing_mapping" \
      --batch-size 20 \
      --function-response-types ReportBatchItemFailures \
      --filter-criteria '{"Filters": [{"Pattern": "{\"eventName\": [\"INSERT\"]}"}]}' \
      --endpoint-url "$AWS_ENDPOINT" \
      --region "$AWS_REGION" \
      > /dev/null
    echo "  ✓ Updated event source mapping: $existing_mapping"
  else
    aws lambda create-event-source-mapping \
      --function-name "$EVENTS_PUBLISHER_LAMBDA_NAME" \
      --event-source-arn "$stream_arn" \
      --starting-position LATEST \
      --batch-size 20 \
      --function-response-types ReportBatchItemFailures \
      --filter-criteria '{"Filters": [{"Pattern": "{\"eventName\": [\"INSERT\"]}"}]}' \
      --endpoint-url "$AWS_ENDPOINT" \
      --region "$AWS_REGION" \
      > /dev/null
    echo "  ✓ Created event source mapping for DynamoDB stream"
  fi
}

main() {
  start_floci
  create_sns_topics
  create_incoming_sqs_queues_and_subscriptions
  create_events_dynamodb_table
  create_snapshots_dynamodb_table
  zip_events_publisher_lambda
  create_events_publisher_lambda
  subscribe_events_publisher_lambda_to_dynamodb

  echo "Local setup complete!"
}

main